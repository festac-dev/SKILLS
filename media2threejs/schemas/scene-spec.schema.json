{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "Scene Spec", "type": "object",
  "required": ["schemaVersion", "world", "environmentBounds", "cameras", "landmarkObservations", "cameraResiduals", "lights", "layout", "assetInstances", "proxyInstances", "debugViews"],
  "properties": {"schemaVersion": {"type": "string"}, "world": {"type": "object", "required": ["units", "handedness", "up", "assetForward"], "properties": {"units": {"const": "meters"}, "handedness": {"const": "right"}, "up": {"const": "+Y"}, "assetForward": {"const": "+Z"}}},
    "roomShell": {"type": "object"}, "environmentBounds": {"$ref": "#/$defs/bounds"}, "cameras": {"type": "array"}, "landmarkObservations": {"type": "array"}, "cameraResiduals": {"type": "array"}, "lights": {"type": "array"},
    "layout": {"type": "array", "items": {"type": "object", "required": ["id", "position", "rotation", "scale", "dimensions", "relationship", "supportingFrameIds", "confidence", "approximationNotes"], "anyOf": [{"required": ["assetId"]}, {"required": ["proceduralRecipe"]}], "properties": {"id": {"type": "string"}, "assetId": {"type": "string"}, "proceduralRecipe": {"type": "string"}, "position": {"$ref": "#/$defs/vec3"}, "rotation": {"$ref": "#/$defs/vec3"}, "scale": {"$ref": "#/$defs/vec3"}, "dimensions": {"type": "object", "required": ["value", "basis"], "properties": {"value": {"$ref": "#/$defs/vec3"}, "basis": {"enum": ["measured", "estimated"]}}}, "relationship": {"type": "string"}, "supportingFrameIds": {"type": "array", "items": {"type": "string"}}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "approximationNotes": {"type": "string"}}}},
    "objectRelationships": {"type": "array"}, "assetInstances": {"type": "array"}, "proxyInstances": {"type": "array"}, "timelineReference": {"type": ["string", "null"]}, "debugViews": {"type": "array"}},
  "$defs": {"vec3": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}], "minItems": 3, "maxItems": 3}, "bounds": {"type": "object", "required": ["min", "max"], "properties": {"min": {"$ref": "#/$defs/vec3"}, "max": {"$ref": "#/$defs/vec3"}}}}
}
